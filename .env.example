# testagent-cloud-sandbox-service .env.example

# OpenSandbox 服务地址
TA_SS_OPENSANDBOX_URL=http://host.docker.internal:8000
# OpenSandbox 认证 Key (可选，留空以无认证访问 OpenSandbox 服务)
TA_SS_OPENSANDBOX_API_KEY=

# 镜像默认注册表 (容器仓库) 地址
TA_SS_IMAGE_DEFAULT_REGISTRY=http://host.docker.internal:5000
# 镜像默认命名空间
TA_SS_IMAGE_DEFAULT_NAMESPACE=testagent

# 容器创建限制模式，当前可选 user 或 repository (白名单用户与管理员用户无视此选项)
TA_SS_CONTAINER_CREATE_LIMIT_MODE=user
# 容器业务有效时长，单位为小时，0 表示永不过期，到期后执行业务删除
TA_SS_CONTAINER_DEFAULT_EXPIRATION_HOURS=24
# 容器业务删除后物理保留时长，单位为小时，0 表示永久保留，到期后执行物理删除
TA_SS_CONTAINER_RETENTION_HOURS=168
# 容器最大可用数目，0 表示取消数量限制 (白名单用户与管理员用户无视此选项)
TA_SS_CONTAINER_DEFAULT_COUNT_LIMIT=30

# REST API 监听端口
TA_SS_REST_API_PORT=8080
# REST API 文档鉴权使用的用户名和密码
TA_SS_REST_API_USERNAME=admin
TA_SS_REST_API_PASSWORD=change-me

# 调度器轮询周期，单位为秒
TA_SS_SCHEDULER_POLL_INTERVAL_SECONDS=5

# 日志级别：DEBUG、INFO、WARNING 或 ERROR
TA_SS_LOG_LEVEL=INFO
